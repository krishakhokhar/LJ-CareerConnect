# Server
PORT=5000
NODE_ENV=development

# Database
# Local:  mongodb://127.0.0.1:27017/lj_careerconnect
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/lj_careerconnect?retryWrites=true&w=majority
# The database name is also enforced in code (backend/src/config/db.js), so it
# does not strictly need to be in this string - but include it for clarity.
MONGO_URI=mongodb://127.0.0.1:27017/lj_careerconnect

# Auth
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cloudinary (file storage for resumes, certificates, logos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (optional - falls back to local deterministic AI engine if not set)
GEMINI_API_KEY=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin seed account (used only by seed script)
ADMIN_EMAIL=admin@ljcareerconnect.edu
ADMIN_PASSWORD=Admin@12345
