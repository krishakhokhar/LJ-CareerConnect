# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment - ignore every .env variant, but keep the .example templates
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Build
frontend/dist/
backend/dist/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads (local fallback storage)
backend/uploads/*
!backend/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.local
coverage/
